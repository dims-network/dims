#!/usr/bin/env python3
"""Kept for the path in people's fingers and in older docs.

The command itself is dims_case.cli, so that `pip install dims-network` gets a
working `dims-case` rather than one that only runs from a checkout.
"""
import os
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
    "packages", "dims-case"))

from dims_case.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
